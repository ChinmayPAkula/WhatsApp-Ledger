# WhatsApp / Meta
WHATSAPP_TOKEN=your_permanent_access_token_from_meta
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose   # e.g. "mystore_webhook_secret_2024"
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Groq (Phase 2 — structured extraction)
GROQ_API_KEY=your_groq_api_key

# Twilio (Phase 3 — proactive monthly report send)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated — every number listed gets the automatic monthly report
OWNER_WHATSAPP_TO=whatsapp:+91yourphonenumber,whatsapp:+91anotherphonenumber

# API key required in the X-API-Key header for GET /messages, /entries, /export
API_ACCESS_KEY=generate_a_long_random_string

# Password required in WhatsApp for the audit-log request (e.g. "send me this
# month logs password pineapple")
AUDIT_LOG_PASSWORD=choose_a_password
